# Copy to .env and fill in what you need. Never commit .env.

DATABASE_URL=sqlite:///./it_reports.db
REPORTS_DIR=./data/reports

# Email delivery (optional) - leave blank to disable the "Send Email" button
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REPORT_EMAIL_TO=

# Telegram delivery (optional) - message @BotFather for a token, and
# @userinfobot (or similar) for your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
