# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
DATABASE_URL=sqlite:///./faceless_pipeline.db
ENV=development

# --- Module 1: Trend finder ---
TREND_SEED_KEYWORDS=ai tools,personal finance,productivity hacks
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=faceless-pipeline/0.1 by yourusername
REDDIT_SUBREDDITS=todayilearned,LifeProTips,Showerthoughts
NEWSAPI_KEY=
NEWS_COUNTRY=us
NEWS_CATEGORY=
ENABLE_TIKTOK_TRENDS=true
TIKTOK_TRENDING_COUNTRY=US

# --- Module 2: Script generator ---
# SCRIPT_PROVIDER selects which LLM writes the script: anthropic | ollama |
# openai | gemini | groq. Only fill in the section for the one you picked —
# the rest can stay empty. See README.md for the full walkthrough of each.
SCRIPT_PROVIDER=anthropic

# anthropic — paid, hosted
ANTHROPIC_API_KEY=
SCRIPT_MODEL=claude-sonnet-5

# ollama — free, local, no API key (https://ollama.com, `ollama pull llama3.2`, `ollama serve`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# openai — paid, hosted (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# gemini — has a free tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash

# groq — fast open-model hosting, has a free tier (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- Module 3: Voice generation ---
KOKORO_VOICE=af_heart
TTS_FALLBACK_API_KEY=
TTS_FALLBACK_PROVIDER=elevenlabs

# --- Module 4: Video assembly ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
FFMPEG_BINARY=ffmpeg
FFMPEG_TIMEOUT_SECONDS=600
OUTPUT_DIR=./data/videos

# --- Module 5: Review checkpoint notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Module 6: Publisher ---
# Both YouTube and TikTok accounts are connected from the dashboard's
# Settings page ("Connect YouTube" / "Connect TikTok") once the app
# credentials below are filled in - no need to run anything by hand.
DASHBOARD_URL=http://localhost:5173

# YouTube: create an OAuth client of type "Web application" in Google
# Cloud Console, enable the YouTube Data API v3, add YOUTUBE_REDIRECT_URI
# below as an authorized redirect URI on that client, and download the
# client secret JSON to YOUTUBE_CLIENT_SECRETS_FILE.
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/publish/accounts/youtube/callback

# TikTok Content Posting API v2 - apply for app access at
# https://developers.tiktok.com/products/content-posting-api/ (your own
# account can post immediately after creating a sandbox app; posting to
# other accounts needs app review, which takes weeks). Add
# TIKTOK_REDIRECT_URI below as the app's redirect URI in the TikTok
# developer portal.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
TIKTOK_TOKEN_FILE=./secrets/tiktok_token.json
TIKTOK_REDIRECT_URI=http://localhost:8000/api/publish/accounts/tiktok/callback
TIKTOK_DEFAULT_PRIVACY_LEVEL=SELF_ONLY

# Instagram Reels via the Meta Graph API - create an app at
# https://developers.facebook.com, add the "Instagram Graph API" product,
# set INSTAGRAM_APP_ID/_SECRET, add INSTAGRAM_REDIRECT_URI below as a
# valid OAuth redirect URI on that app, and add the Facebook Page (linked
# to an Instagram Business/Creator account) as a tester/admin. Unlike
# YouTube/TikTok, Instagram fetches the video from a URL rather than
# accepting a direct upload, so PUBLIC_BASE_URL (this backend's own
# public HTTPS origin) must also be set before Instagram publishing works.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_BASE_URL=https://graph.facebook.com/v19.0
INSTAGRAM_TOKEN_FILE=./secrets/instagram_token.json
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/publish/accounts/instagram/callback
PUBLIC_BASE_URL=

# --- Module 8: Analytics ---
YOUTUBE_ANALYTICS_TOKEN_FILE=./secrets/youtube_analytics_token.json

# --- Automation: all opt-in / off by default. Turning one on doesn't
# change any of the others - review README.md's Automation section before
# enabling AUTO_APPROVE_ENABLED specifically, since it skips the human
# checkpoint for videos that pass its (basic) safety checks. ---

# Auto-generates (and assembles into a video) a script for the top N
# unused trends every time the trend finder runs, instead of always
# requiring a manual topic pick from the Trends page.
AUTO_GENERATE_ENABLED=false
AUTO_GENERATE_COUNT=1
AUTO_GENERATE_MIN_SCORE=0
AUTO_GENERATE_STYLE=explainer
AUTO_GENERATE_LENGTH_VARIANT=30s

# Runs the trend finder (and AUTO_GENERATE, if also enabled) on a fixed
# interval instead of only when triggered manually or by an external cron.
AUTO_TREND_FINDER_ENABLED=false
AUTO_TREND_FINDER_INTERVAL_HOURS=24

# Skips the human review click for a video whose storyboard is complete,
# has a real rendered file, and (if set) whose audio is at least this long.
AUTO_APPROVE_ENABLED=false
AUTO_APPROVE_MIN_AUDIO_SECONDS=3.0

# A/B style testing: biases which style AUTO_GENERATE/full-cycle picks
# toward whichever has historically performed best (Module 8's
# best_performing_patterns), with 20% random exploration so the feedback
# loop keeps collecting data on non-winning styles too.
AB_TEST_ENABLED=false
AB_TEST_STYLES=explainer,listicle,story,hot_take

# Cheap, no-network checks (ffmpeg present, active provider's key set,
# YouTube/TikTok authorized) every N minutes - surfaces a dashboard toast
# the moment something breaks, not the next time a run trips over it.
# Always on (not gated by a *_ENABLED flag - it's free and has no side effects).
HEALTH_CHECK_INTERVAL_MINUTES=30

# Periodic Telegram/Discord summary (trends found, scripts generated,
# videos published, top performer) instead of only per-video pings.
DIGEST_ENABLED=false
DIGEST_INTERVAL_HOURS=24

# Refuses to start a new script generation once estimated LLM spend hits
# either cap (0 = unlimited). Tracked in-memory only (resets on restart);
# a guardrail against runaway usage, not a precise billing system.
DAILY_COST_BUDGET_USD=0
MONTHLY_COST_BUDGET_USD=0

# Purges rejected videos (+ their rendered files) and superseded scripts
# older than the retention window.
CLEANUP_ENABLED=false
CLEANUP_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=24

# Automatic retries (exponential backoff) for a script/video generation
# stage that fails on a transient error, before it's recorded as failed.
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=30
