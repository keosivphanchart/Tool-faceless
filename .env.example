# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
DATABASE_URL=sqlite:///./faceless_pipeline.db
ENV=development

# --- Module 1: Trend finder ---
TREND_SEED_KEYWORDS=ai tools,personal finance,productivity hacks
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=faceless-pipeline/0.1 by yourusername
REDDIT_SUBREDDITS=todayilearned,LifeProTips,Showerthoughts
NEWSAPI_KEY=
NEWS_COUNTRY=us
NEWS_CATEGORY=
ENABLE_TIKTOK_TRENDS=true
TIKTOK_TRENDING_COUNTRY=US

# --- Module 2: Script generator ---
# SCRIPT_PROVIDER=anthropic uses a paid Claude API key (set ANTHROPIC_API_KEY below).
# SCRIPT_PROVIDER=ollama uses a free, local model instead — no API key, no
# per-call cost. Install Ollama (https://ollama.com), run `ollama pull llama3.2`
# once, then `ollama serve` (or let it run as a background service) before
# generating scripts. See README.md for the full walkthrough.
SCRIPT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
SCRIPT_MODEL=claude-sonnet-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Module 3: Voice generation ---
KOKORO_VOICE=af_heart
TTS_FALLBACK_API_KEY=
TTS_FALLBACK_PROVIDER=elevenlabs

# --- Module 4: Video assembly ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
FFMPEG_BINARY=ffmpeg
FFMPEG_TIMEOUT_SECONDS=600
OUTPUT_DIR=./data/videos

# --- Module 5: Review checkpoint notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Module 6: Publisher ---
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Module 8: Analytics ---
YOUTUBE_ANALYTICS_TOKEN_FILE=./secrets/youtube_analytics_token.json
